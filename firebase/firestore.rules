rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() { return signedIn() &&
      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
      me().active == true; }
    function adminUser() { return active() && me().role == 'admin'; }
    function sameOrg(org) { return active() && me().orgId == org; }

    match /users/{uid} {
      allow read: if active() && (request.auth.uid == uid || adminUser());
      // Only admins can change roles, and only within their own organization.
      allow create: if adminUser() && request.resource.data.orgId == me().orgId;
      allow update: if adminUser() && resource.data.orgId == me().orgId &&
        request.resource.data.orgId == resource.data.orgId;
      allow delete: if false;
    }
    match /audits/{auditId} {
      allow read: if sameOrg(resource.data.orgId);
      allow create: if active() && request.resource.data.orgId == me().orgId &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if sameOrg(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId;
      allow delete: if adminUser() && resource.data.orgId == me().orgId;
    }
    match /emailDeliveries/{deliveryId} {
      allow read: if adminUser();
      allow write: if false; // Cloud Function only.
    }
    match /{document=**} { allow read, write: if false; }
  }
}
