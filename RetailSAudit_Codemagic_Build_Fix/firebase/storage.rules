rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function orgId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.orgId;
    }
    match /report-bundles/{auditId}/{bundleId}/{fileName} {
      allow read: if active() &&
        firestore.get(/databases/(default)/documents/audits/$(auditId)).data.orgId == orgId();
      allow write: if active() &&
        fileName in ['audit.xlsx','soh.xlsx','variance.xlsx'] &&
        firestore.get(/databases/(default)/documents/audits/$(auditId)).data.orgId == orgId() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' &&
        request.resource.metadata.orgid == orgId();
    }
  }
}
